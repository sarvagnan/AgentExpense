{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "additions.schema.json",
  "title": "Live expense audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "time"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "enum": [
        "draft",
        "statement",
        "review",
        "review-action",
        "rule",
        "rule-review",
        "correction"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "draft_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "added",
        "failed",
        "not_expense",
        "discarded"
      ]
    },
    "text": {
      "type": "string"
    },
    "saved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "pieces": {
      "type": [
        "object",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original_name"
        ],
        "properties": {
          "original_name": {
            "type": "string"
          },
          "filed_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer",
          "asked_at"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "asked_at": {
            "type": "string",
            "format": "date-time"
          },
          "answered_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model",
          "effort",
          "start",
          "end",
          "outcome",
          "usage",
          "lookups",
          "error"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "effort": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "type": "object"
          },
          "lookups": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "doubts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": [
              "number",
              "null"
            ]
          },
          "adapter": {
            "type": "string",
            "description": "Optional adapter id; older runs used Codex."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_kind": {
            "enum": [
              "usage_limit",
              "auth",
              "transient",
              "bad_answer"
            ]
          },
          "reset_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stderr_tail": {
            "type": "string",
            "maxLength": 4000
          },
          "normalisations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "proposal": {
      "type": [
        "object",
        "null"
      ]
    },
    "doubts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement": {
      "type": "object",
      "required": [
        "periodStart",
        "periodEnd",
        "source"
      ],
      "properties": {
        "periodStart": {
          "type": "string",
          "format": "date"
        },
        "periodEnd": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extraction": {
      "enum": [
        "parser",
        "agent",
        "reader"
      ]
    },
    "line_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "verdict": {
      "enum": [
        "ok",
        "issue"
      ]
    },
    "note": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "client_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00)$",
      "description": "Local save time with explicit UTC offset; optional on version 1 draft events."
    },
    "client_zone": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_+/-]+$",
      "description": "IANA zone at save time, or the server local zone for non-browser and legacy drafts."
    },
    "action": {
      "enum": [
        "resolve",
        "followup",
        "acknowledge",
        "separate",
        "undo-separate",
        "merge",
        "import"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "before_version",
          "after_version"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "other_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "before_version": {
            "type": "string"
          },
          "after_version": {
            "type": "string"
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "account",
              "label",
              "notes",
              "updatedAt"
            ],
            "properties": {
              "account": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "resolved",
                  "followup"
                ]
              }
            }
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "undoes": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "kept_id": {
            "type": "string"
          },
          "removed_id": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "original": {
            "type": "object",
            "description": "Original version-2 export identity before the first decision, retained for portable exports and changed-entry detection."
          }
        }
      }
    },
    "finished_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "reason"
      ],
      "properties": {
        "actor": {
          "const": "user"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "account_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_hash",
        "accounts",
        "method"
      ],
      "properties": {
        "proposal_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "method": {
          "enum": [
            "create-and-add",
            "hand-ticks"
          ]
        }
      }
    },
    "usual_payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "occurrence",
        "request_hash",
        "estimated",
        "update_rule",
        "another_anyway",
        "remember_account"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "occurrence": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "estimated": {
          "type": "boolean"
        },
        "update_rule": {
          "type": "boolean"
        },
        "another_anyway": {
          "type": "boolean"
        },
        "remember_account": {
          "type": "boolean"
        }
      }
    },
    "rule_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "rule_action": {
      "enum": [
        "made",
        "edited",
        "paused",
        "resumed",
        "ended",
        "restored",
        "removed",
        "kept",
        "undone",
        "catch-up",
        "backfill",
        "bill-saved",
        "bill-removed",
        "bill-paid"
      ]
    },
    "undoes": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "reversal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "rule_verdict": {
      "enum": [
        "confirm",
        "propose-removal"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 0
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "changed_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object"
    },
    "receipt": {
      "type": "object"
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "account",
        "account_label",
        "date",
        "entry_id",
        "source",
        "commodity",
        "asserted",
        "calculated",
        "difference",
        "possible_duplicates",
        "detail"
      ],
      "properties": {
        "account": {
          "type": "string"
        },
        "account_label": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "entry_id": {
          "type": "string"
        },
        "commodity": {
          "type": "string"
        },
        "asserted": {
          "type": "string"
        },
        "calculated": {
          "type": "string"
        },
        "difference": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "kind": {
          "const": "confirmed_balance"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "label",
            "date"
          ],
          "properties": {
            "kind": {
              "enum": [
                "statement",
                "balance"
              ]
            },
            "label": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "possible_duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_id",
              "date",
              "description",
              "amount",
              "commodity"
            ],
            "properties": {
              "entry_id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              },
              "commodity": {
                "type": "string"
              }
            }
          }
        },
        "restriction": {
          "enum": [
            "locked_posting",
            "date_window",
            "same_day_order"
          ]
        }
      }
    },
    "bill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "received",
        "occurrence",
        "sources"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$"
        },
        "received": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "pay_by": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "occurrence": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        }
      }
    },
    "amount_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "min",
        "max",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string"
        },
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "draft"
          }
        }
      },
      "then": {
        "required": [
          "draft_id",
          "outcome",
          "text",
          "saved_at",
          "pieces",
          "files",
          "questions",
          "runs",
          "proposal",
          "doubts",
          "check_errors",
          "error",
          "entry_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "statement"
          }
        }
      },
      "then": {
        "required": [
          "statement",
          "counts",
          "decisions",
          "entry_ids",
          "extraction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review"
          }
        }
      },
      "then": {
        "required": [
          "line_id",
          "verdict",
          "note",
          "reviewer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review-action"
          }
        }
      },
      "then": {
        "required": [
          "action",
          "request_id",
          "request_hash",
          "changes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rule"
          }
        }
      },
      "then": {
        "required": [
          "rule_action",
          "request_id",
          "request_hash",
          "rule_changes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rule-review"
          }
        }
      },
      "then": {
        "required": [
          "rule_id",
          "rule_verdict",
          "reason",
          "reviewer"
        ],
        "properties": {
          "reason": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "correction"
          }
        }
      },
      "then": {
        "required": [
          "entry_id",
          "operation_id",
          "request_hash",
          "before",
          "after",
          "changed_fields",
          "reason",
          "actor",
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rule"
          },
          "rule_action": {
            "enum": [
              "bill-saved",
              "bill-removed",
              "bill-paid"
            ]
          }
        },
        "required": [
          "kind",
          "rule_action"
        ]
      },
      "then": {
        "required": [
          "rule_id",
          "bill",
          "text",
          "files",
          "doubts"
        ]
      }
    }
  ],
  "dependentRequired": {
    "client_time": [
      "client_zone"
    ],
    "client_zone": [
      "client_time"
    ]
  },
  "$defs": {
    "reason": {
      "enum": [
        "amount-date-gap",
        "dissimilar-name",
        "several-candidates",
        "overlapping-statements",
        "imported-after-start"
      ]
    }
  }
}
