{
  "decimal": {
    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
    "type": "string"
  },
  "text": {
    "pattern": "^[^\\r\\n]+$",
    "type": "string"
  },
  "whole-number": {
    "minimum": 0,
    "type": "integer"
  },
  "date": {
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
  },
  "yes-no": {
    "type": "boolean"
  },
  "choice": {
    "type": "string"
  }
}
