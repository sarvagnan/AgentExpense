import os
import shutil
import stat
import sys
import tempfile
from pathlib import Path

from pypdf import PdfReader, PdfWriter


def collect(values):
    result = []
    seen = set()
    for value in values:
        supplied = Path(value).expanduser().absolute()
        try:
            candidates = sorted(supplied.iterdir()) if supplied.is_dir() else [supplied]
        except OSError:
            candidates = [supplied]
        for path in candidates:
            if path.suffix.lower() == ".pdf" and path not in seen:
                seen.add(path)
                result.append(path)
    return result


def copy_xattrs(source, destination):
    try:
        names = os.listxattr(source, follow_symlinks=False)
    except (AttributeError, OSError):
        return
    for name in names:
        try:
            value = os.getxattr(source, name, follow_symlinks=False)
            os.setxattr(destination, name, value, follow_symlinks=False)
        except OSError:
            pass


def unlock(path, password):
    if path.is_symlink():
        return "FAILED: symbolic links are not supported"
    if not path.is_file():
        return "FAILED: file does not exist"

    temporary = None
    try:
        reader = PdfReader(path, strict=False)
        if not reader.is_encrypted:
            return "already unlocked"
        if not reader.decrypt(password):
            return "FAILED: incorrect password"

        page_count = len(reader.pages)
        original_stat = path.stat()
        writer = PdfWriter(clone_from=reader)

        descriptor, name = tempfile.mkstemp(
            prefix=f".{path.name}.unlocking-",
            suffix=".pdf",
            dir=path.parent,
        )
        temporary = Path(name)
        with os.fdopen(descriptor, "wb") as output:
            writer.write(output)
            output.flush()
            os.fsync(output.fileno())

        check = PdfReader(temporary, strict=False)
        if check.is_encrypted:
            raise ValueError("output remains encrypted")
        if len(check.pages) != page_count:
            raise ValueError("page-count mismatch")

        os.chmod(temporary, stat.S_IMODE(original_stat.st_mode))
        shutil.copystat(path, temporary, follow_symlinks=False)
        copy_xattrs(path, temporary)
        os.replace(temporary, path)
        temporary = None
        return "unlocked and replaced"
    except Exception as error:
        return f"FAILED: {error}"
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


items = sys.stdin.read().splitlines()
if len(items) &lt; 2:
    raise SystemExit("Missing PDF input or password.")

password = items[-1]
pdfs = collect(items[:-1])
if not pdfs:
    raise SystemExit("No PDF files were supplied.")

results = [(path, unlock(path, password)) for path in pdfs]
print("\n".join(f"{path.name}: {result}" for path, result in results))
