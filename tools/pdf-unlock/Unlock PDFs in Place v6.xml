# /// script
# requires-python = "&gt;=3.12"
# dependencies = ["pypdf[crypto]&gt;=6.16,&lt;7"]
# ///

import sys
from pathlib import Path

from pypdf import PdfReader


def collect(values):
    result = []
    for value in values:
        supplied = Path(value).expanduser().absolute()
        try:
            candidates = sorted(supplied.iterdir()) if supplied.is_dir() else [supplied]
        except OSError:
            candidates = [supplied]
        result.extend(
            path for path in candidates
            if path.suffix.lower() == ".pdf" and path.is_file()
        )
    return result


pdfs = collect(sys.argv[1:])
if not pdfs:
    raise SystemExit("No PDF files were supplied.")

sys.stdout.write("yes" if any(PdfReader(path, strict=False).is_encrypted for path in pdfs) else "no")
