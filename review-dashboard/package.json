{
  "name": "expense-ledger-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-static-views.mjs",
    "check:data": "node scripts/check-dashboard-data.mjs",
    "data": "EXPENSES_BUILD_SNAPSHOT=1 node scripts/build-data.mjs",
    "start": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "python3 ../scripts/test_run.py node scripts/test-dashboard.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.319",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@openai/codex": "0.166.0",
    "@opencode/cli": "2.2.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
