{
  "name": "expense-ledger-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-static-views.mjs",
    "check:data": "node scripts/check-dashboard-data.mjs",
    "data": "node scripts/copy-fuel-log.mjs && node scripts/build-dashboard-data.mjs && node scripts/build-review-data.mjs && node scripts/build-add-patterns.mjs && node scripts/check-dashboard-data.mjs && node scripts/compress-dashboard-data.mjs",
    "start": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.166.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
